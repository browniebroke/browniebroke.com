---
import React from "react";

import BaseLayout from "../layouts/BaseLayout.astro";

import { Avatar } from "../components/avatar";
import { SocialLinks } from "../components/social";
import { SectionTitle } from "../components/section-title";
import { LatestEntriesList } from "../components/post-list";

import { getLatestEntries } from "../utils/contents";
import { site } from "../data/siteMetadata";

const latestEntries = await getLatestEntries(6);
---

<BaseLayout title="Home">
  <section class="flex flex-col items-center">
    <h1 class="text-4xl font-bold mt-8 mb-4">{site.author}</h1>
    <Avatar />
    <p class="text-center max-w-[400px]">{site.bio}</p>
    <p class="text-center max-w-[400px]">
      Here you'll find long blog posts and short "Today I Learned" notes.
    </p>
    <SocialLinks />
  </section>
  <section>
    <SectionTitle>Latest writing</SectionTitle>

    <LatestEntriesList entries={latestEntries} />

    <ul class="my-12 flex flex-wrap justify-center gap-x-6">
      <li><a href="/blog/">All posts</a></li>
      <li><a href="/tils/">All TILs</a></li>
      <li><a href="/all.xml">Everything feed (RSS)</a></li>
    </ul>
  </section>
</BaseLayout>
